{
  "paths": {
    "simulation_dir": "validation_data",
    "simulation_glob": "**/chunk_*_Param14.npz",
    "real_dir": "RealData",
    "manifest": "RealData/participants.csv",
    "checkpoint": "TrainWorks/checkpoints/neurodynEEG_best.pth",
    "prepared_dir": "validation/cache/real",
    "results_dir": "validation/results"
  },
  "inference": {"device": "auto", "batch_size": 64},
  "real": {
    "sfreq": 256,
    "segment_seconds": 5,
    "channels": ["FP1", "FP2", "FZ", "F3", "F4", "F7", "F8", "CZ", "C3", "C4", "PZ", "P3", "P4", "T3", "T4", "T5", "T6", "O1", "O2"],
    "bandpass_hz": [1, 40],
    "notch_hz": [],
